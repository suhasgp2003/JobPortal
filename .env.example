# Copy to .env and fill in what you need. Everything is optional.
SECRET_KEY=change-me
DEBUG=True

# PostgreSQL (leave blank for SQLite)
POSTGRES_PASSWORD=
POSTGRES_DB=careernest
POSTGRES_USER=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis + Celery (leave blank to run tasks in-process)
REDIS_URL=

# Email (leave blank to print emails/OTPs to the console)
EMAIL=
EMAIL_PASSWORD=
CONTACT_EMAIL=

# Twilio SMS (leave blank to print SMS OTPs to the console)
TWILIO_SID=
TWILIO_AUTH=
FROM_NO=
